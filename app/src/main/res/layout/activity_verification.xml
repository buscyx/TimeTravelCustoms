<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_verification_mng"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#E8EDF2">

    <!-- Left side: Passport image -->

    <ImageView
        android:id="@+id/img_passport_mng"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@android:drawable/ic_menu_myplaces"
        android:scaleType="centerInside"
        android:contentDescription="Traveler passport"/>

    <!-- Right side: Traveler information -->

    <RelativeLayout
        android:id="@+id/info_container_mng"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_title_mng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIME TRAVEL PASSPORT"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#263B53"
            android:gravity="center"
            android:padding="10dp"/>

        <TextView
            android:id="@+id/tv_name_mng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_title_mng"
            android:layout_marginTop="30dp"
            android:text="TRAVELER:"
            android:textSize="16sp"
            android:textColor="#222222"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_age_mng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_name_mng"
            android:layout_marginTop="15dp"
            android:text="TEMPORAL AGE:"
            android:textSize="16sp"
            android:textColor="#222222"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_reason_mng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_mng"
            android:layout_marginTop="15dp"
            android:text="TRAVEL REASON:"
            android:textSize="16sp"
            android:textColor="#222222"
            android:padding="8dp"/>

        <!-- Approval and rejection buttons -->

        <LinearLayout
            android:id="@+id/buttons_container_mng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_reason_mng"
            android:layout_marginTop="35dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_approve_mng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APPROVE TIME JUMP"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btn_reject_mng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="REJECT TIME JUMP"
                android:textSize="12sp"/>

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>